    "matchInvites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && $from !== $to && ((auth.uid === $from && (!newData.exists() || ((!data.exists() || data.child('status').val() !== 'pending') && newData.child('status').val() === 'pending' && root.child('matchLounge').child($from).child('status').val() === 'available' && root.child('matchLounge').child($from).child('updatedAt').val() > now - 240000 && root.child('matchLounge').child($to).child('status').val() === 'available' && root.child('matchLounge').child($to).child('updatedAt').val() > now - 240000 && newData.child('createdAt').val() >= now - 300000 && newData.child('createdAt').val() <= now + 60000))) || (auth.uid === $to && data.child('status').val() === 'pending' && newData.child('fromUid').val() === data.child('fromUid').val() && newData.child('toUid').val() === data.child('toUid').val() && newData.child('fromName').val() === data.child('fromName').val() && newData.child('fromAvatar/kind').val() === data.child('fromAvatar/kind').val() && newData.child('fromAvatar/value').val() === data.child('fromAvatar/value').val() && newData.child('roomCode').val() === data.child('roomCode').val() && newData.child('createdAt').val() === data.child('createdAt').val() && (newData.child('status').val() === 'declined' || (newData.child('status').val() === 'accepted' && data.child('createdAt').val() > now - 86400000 && root.child('selectedRooms').child(data.child('roomCode').val()).child('meta/hostUid').val() === $to && root.child('selectedRooms').child(data.child('roomCode').val()).child('meta/guestUid').val() === $from && root.child('selectedRooms').child(data.child('roomCode').val()).child('members').child($to).exists() && root.child('selectedRooms').child(data.child('roomCode').val()).child('members').child($from).exists()))))",
          ".validate": "newData.hasChildren(['fromUid','toUid','fromName','fromAvatar','status','roomCode','createdAt'])",
          "fromUid": {
            ".validate": "newData.val() === $from"
          },
          "toUid": {
            ".validate": "newData.val() === $to"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 26"
          },
          "fromAvatar": {
            ".validate": "newData.hasChildren(['kind','value'])",
            "kind": {
              ".validate": "newData.val() === 'emoji' || newData.val() === 'url' || newData.val() === 'data'"
            },
            "value": {
              ".validate": "newData.isString() && ((newData.parent().child('kind').val() === 'emoji' && newData.val().length > 0 && newData.val().length <= 30) || (newData.parent().child('kind').val() === 'url' && newData.val().length <= 700 && newData.val().matches(/^https?:\\/\\/.+/)) || (newData.parent().child('kind').val() === 'data' && newData.val().length <= 0 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)))"
            },
            "$other": {
              ".validate": false
            }
          },
          "status": {
            ".validate": "newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'declined'"
          },
          "roomCode": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8}$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
