      ".read": "auth != null",
      ".indexOn": [
        "updatedAt"
      ],
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['hostUid','code','hostName','locked','updatedAt']) && newData.child('hostUid').val() === $uid && newData.child('code').isString() && newData.child('code').val().matches(/^[A-Z0-9]{8}$/) && root.child('rooms').child(newData.child('code').val()).child('meta/hostUid').val() === $uid && root.child('rooms').child(newData.child('code').val()).child('meta/listed').val() === true && newData.child('locked').val() === !(root.child('rooms').child(newData.child('code').val()).child('meta/passwordless').val() === true)",
