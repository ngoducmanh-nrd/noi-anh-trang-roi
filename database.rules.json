              },
              "$other": {
                ".validate": false
              }
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          ".validate": "newData.hasChildren([newData.parent().child('meta/hostUid').val(),newData.parent().child('meta/guestUid').val()])"
        },
        "messages": {
          ".indexOn": [
            "at"
          ],
          "$message": {
            ".write": "(auth != null && root.child('selectedRooms').child($code).child('members').child(auth.uid).exists()) && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid','name','text','at'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 26"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 60000"
            },
            "avatar": {
              ".validate": "newData.hasChildren(['kind','value'])",
              "kind": {
                ".validate": "newData.val() === 'emoji' || newData.val() === 'url' || newData.val() === 'data'"
              },
              "value": {
                ".validate": "newData.isString() && ((newData.parent().child('kind').val() === 'emoji' && newData.val().length > 0 && newData.val().length <= 30) || (newData.parent().child('kind').val() === 'url' && newData.val().length <= 700 && newData.val().matches(/^https?:\\/\\/.+/)) || (newData.parent().child('kind').val() === 'data' && newData.val().length <= 12000 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)))"
              },
              "$other": {
                ".validate": false
              }
            },
            "sticker": {
              ".validate": "newData.isString() && newData.val().length <= 62000 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomPasswords": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
        ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid && newData.exists()",
        ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
      }
    },
    "roomAccess": {
      "$code": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid && newData.isString() && newData.val() === root.child('roomPasswords').child($code).val()",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        }
      }
    },
    "roomPresence": {
      "$kind": {
        "$code": {
          ".read": "auth != null && ($kind === 'rooms' || $kind === 'selectedRooms') && root.child($kind).child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            "$session": {
              ".write": "auth != null && auth.uid === $uid && ($kind === 'rooms' || $kind === 'selectedRooms') && (!newData.exists() || root.child($kind).child($code).child('members').child(auth.uid).exists())",
              ".validate": "$session.matches(/^[-A-Za-z0-9_]{20}$/) && newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 60000"
            }
          }
        }
      }
    },
