{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "(auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists())",
        ".write": "auth != null && !data.exists() && newData.child('meta/hostUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['meta','members']) && $code.matches(/^[A-Z0-9]{8}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['hostUid','createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "passwordless": {
            ".validate": "newData.val() === true && !data.exists()"
          },
          "passwordFormat": {
            ".validate": "newData.val() === 'sha256' && !data.exists()"
          },
          "listed": {
            ".validate": "newData.isBoolean() && !data.exists()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('meta/passwordless').val() === true || (root.child('roomAccess').child($code).child(auth.uid).val() === root.child('roomPasswords').child($code).val() && root.child('roomPasswords').child($code).isString())) && newData.exists()",
            ".validate": "newData.hasChildren(['name','avatar','joinedAt']) && (!root.child('rooms').child($code).exists() ? $uid === auth.uid : true)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 26"
            },
            "avatar": {
              ".validate": "newData.hasChildren(['kind','value'])",
              "kind": {
                ".validate": "newData.val() === 'emoji' || newData.val() === 'url' || newData.val() === 'data'"
              },
              "value": {
                ".validate": "newData.isString() && ((newData.parent().child('kind').val() === 'emoji' && newData.val().length > 0 && newData.val().length <= 30) || (newData.parent().child('kind').val() === 'url' && newData.val().length <= 700 && newData.val().matches(/^https?:\\/\\/.+/)) || (newData.parent().child('kind').val() === 'data' && newData.val().length <= 250000 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)))"
              },
              "$other": {
                ".validate": false
              }
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "messages": {
          ".indexOn": [
            "at"
          ],
          "$message": {
            ".write": "(auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()) && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid','name','text','at'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 26"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 60000"
            },
            "avatar": {
              ".validate": "newData.hasChildren(['kind','value'])",
              "kind": {
                ".validate": "newData.val() === 'emoji' || newData.val() === 'url' || newData.val() === 'data'"
              },
              "value": {
                ".validate": "newData.isString() && ((newData.parent().child('kind').val() === 'emoji' && newData.val().length > 0 && newData.val().length <= 30) || (newData.parent().child('kind').val() === 'url' && newData.val().length <= 700 && newData.val().matches(/^https?:\\/\\/.+/)) || (newData.parent().child('kind').val() === 'data' && newData.val().length <= 12000 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)))"
              },
              "$other": {
                ".validate": false
              }
            },
            "sticker": {
              ".validate": "newData.isString() && newData.val().length <= 62000 && newData.val().matches(/^data:image\\/(webp|jpeg|png);base64,[A-Za-z0-9+\\/=]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "selectedRooms": {
