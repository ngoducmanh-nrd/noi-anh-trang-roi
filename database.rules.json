        ".write": "auth != null && !data.exists() && newData.child('meta/hostUid').val() === auth.uid && root.child('matchInvites').child(auth.uid).child(newData.child('meta/guestUid').val()).child('status').val() === 'pending' && root.child('matchInvites').child(auth.uid).child(newData.child('meta/guestUid').val()).child('roomCode').val() === $code && root.child('matchInvites').child(auth.uid).child(newData.child('meta/guestUid').val()).child('createdAt').val() > now - 86400000 && newData.child('meta/guestUid').val() !== auth.uid",
