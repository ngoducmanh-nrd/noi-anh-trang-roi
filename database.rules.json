            ".validate": false
          }
        }
      }
    },
    "serverSettings": {
      "hearts": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isBoolean()"
      }
    },
    "matchLounge": {
      ".read": "auth != null",
      ".indexOn": [
        "updatedAt"
      ],
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['uid','name','bio','avatar','status','updatedAt'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "name": {
